{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@petlore/types": [
        "./packages/types/src/index.ts"
      ],
      "@petlore/prompts": [
        "./packages/prompts/src/index.ts"
      ],
      "@petlore/agents": [
        "./packages/agents/src/index.ts"
      ],
      "@petlore/media": [
        "./packages/media/src/index.ts"
      ],
      "@petlore/scrapers": [
        "./packages/scrapers/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "upload",
    ".agents",
    "slideshow",
    "apps",
    "packages"
  ]
}
