DATABASE_URL="file:./db/custom.db"

# ─── AI Music Generation (ACE-Step) ──────────────────────────────────────────
# Local ACE-Step instance (SleepWrapper / ACE-Step-1.5 running on port 8001)
ACESTEP_API_URL="http://localhost:8001"

# RunPod serverless (production — leave blank to use local ACE-Step)
RUNPOD_API_KEY=""
RUNPOD_ENDPOINT_ID=""

# Where generated MP3s are stored and served from
AUDIO_DIR="./public/audio"
# Relative path — Next.js serves public/audio at /audio/* (no trailing slash)
AUDIO_BASE_URL="/audio"
